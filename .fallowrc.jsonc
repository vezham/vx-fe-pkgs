{
  "$schema": "./node_modules/fallow/schema.json",
  "resolve": {
    "conditions": ["@vx/fe-kit"]
  },
  "ignoreUnresolvedImports": [
    // vx-bot/NOTE: This CSS export is copied during build; its source is an explicit entry below.
    "@vezham/start/styles/docs",
    // vx-bot/NOTE: Fallow 3.37 misses tsconfig.app.json aliases from docs content and tests outside src.
    // The MDX story is registered below so its implementation remains in the import graph.
    "@components/callout/index.story",
    "@app/docs"
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.output/**",
    "**/.next/**",
    "**/.tanstack/**",
    "**/.source/**",
    "**/.nx/**",
    "**/.git/**",
    "**/coverage/**",
    "**/test-output/**",
    "**/out-tsc/**",
    // vx-bot/NOTE: Preserve the vendored MIT-licensed renderer; audit its authored Tamizhi adapter separately.
    "packages/tamizhi/ui/src/lib/vendor/momo/**",
    "**/*.d.ts",
    // vx-bot/NOTE: Planning MDX documents are not application modules.
    "vx/TODO/**",
    ".agents/**",
    ".codex/**",
    ".vezham/**",
    "**/public/{sw.js,404.html,offline.html}",
    "**/src/generated/**",
    "**/content/**/(generated)/**",
    "**/routeTree.gen.ts",
    "apps*/**/*-mock/**",
    // vx-bot/NOTE: Legacy implementations are outside this npm-consumer workspace.
    "packages/vx/react/**",
    // vx-bot/NOTE: Shared styles are consumed by future generated apps.
    "packages/vx/styles/**"
  ],
  "entry": [
    // vx-bot/NOTE: For Next.js app
    "**/src/app/**/{page,layout,error,global-error,loading,not-found}.tsx",
    "**/src/app/**/route.ts",
    // vx-bot/NOTE: For TanStack app
    "**/src/routes/**/*.{ts,tsx}",
    "**/src/router.tsx",
    // vx-bot/NOTE: For TanStack Docs app
    "**/content/**/*.mdx",
    // vx-bot/NOTE: Referenced by MDX through an alias Fallow 3.37 cannot resolve outside src.
    "apps-internals/playground-docs/src/components/callout/index.story.tsx",
    // vx-bot/NOTE: Public package CSS is copied to dist and consumed through package exports.
    "packages/{core/react,devtools,template}/src/index.css",
    "packages/start/src/styles/docs/index.css",
    // vx-bot/NOTE: Workspace CLI, release, and test files load outside the app import graph.
    "packages/config/src/lib/{metadata,deploy}/cli.ts",
    "packages/config/src/lib/presets/docs/cli.ts",
    "vx/tools/audit/index.mjs",
    "vx/tools/audit/*.test.mjs",
    "vx/tools/eslint/tests/*.test.mjs",
    "vx/tools/release/index.ts",
    "vx/tools/release/*.test.ts",
    "vx/tools/release/version-actions.cjs",
    // vx-bot/NOTE: Executed directly as a runnable backend example and by Playwright's webServer commands.
    "packages/tamizhi/core/examples/server.ts",
    "packages/tamizhi/ui/e2e/{browser.config.ts,provider-fixture.mjs}",
    // vx-bot/NOTE: Nx launches this verifier, and Vitest loads these setup paths dynamically.
    "packages/tamizhi/client/tools/verify-companion.mjs",
    "packages/core/{hooks,react}/test-setup.ts"
  ],
  "framework": [
    {
      "name": "vx-workspace-tools",
      "enablers": ["nx"],
      "toolingDependencies": [
        "@eslint/js",
        "@nx/plugin",
        "@swc-node/register",
        "@swc/helpers",
        // vx-bot/NOTE: The Nx test:eslint command invokes c8 for rule coverage.
        "c8",
        "eslint-config-prettier",
        "eslint-plugin-import",
        "eslint-plugin-react",
        "eslint-plugin-react-hooks",
        "hostile",
        "jiti",
        "react-doctor",
        "sort-package-json",
        "tslib",
        "typescript-eslint",
        "verdaccio",
        "vite-plugin-dts"
      ]
    }
  ],
  "ignoreDependencies": [
    // vx-bot/NOTE: Root-supplied framework integrations remain available for generated Next and TanStack apps.
    "@tailwindcss/postcss",
    "@tanstack/react-router",
    "@tanstack/react-router-devtools",
    "@tanstack/react-start",
    "@tanstack/router-cli",
    "@tanstack/router-plugin",
    "next",
    // vx-bot/NOTE: Required peers of @vezham/react-pro-v3 and @vezham/react-v3.
    "@heroui/react",
    "@heroui/styles",
    "@internationalized/date",
    "@react-aria/utils",
    "motion",
    "react-aria",
    "react-aria-components",
    "react-resizable-panels",
    "react-stately",
    "tailwind-merge",
    "tailwindcss",
    // vx-bot/NOTE: @vezham/config/vite-lib loads this root-supplied declaration plugin.
    "vite-plugin-dts",
    // vx-bot/NOTE: Published packages are declared at root and supplied to app workspaces.
    "@vezham/config",
    // vx-bot/NOTE: Imported by shared CSS under packages/vx/styles, ignored by Fallow.
    "@vezham/devtools",
    "@vezham/env",
    "@vezham/react",
    "@vezham/start",
    "@vezham/template",
    "@vezham/utils",
    "@fontsource/inter",
    "@fontsource/jura",
    "@next/eslint-plugin-next",
    "@number-flow/react",
    "@nx/devkit",
    "@nx/eslint-plugin",
    "@tailwindcss/vite",
    "@tanstack/react-devtools",
    "@tanstack/react-query",
    "@tanstack/react-query-devtools",
    // vx-bot/NOTE: Shared Vitest setup uses this dependency declared at the workspace root.
    "@testing-library/jest-dom",
    "@testing-library/react",
    // vx-bot/NOTE: Package Vitest setup files use this test dependency declared at the workspace root.
    "fake-indexeddb",
    "@tiptap/core",
    "@tiptap/extension-link",
    "@tiptap/extension-underline",
    "@tiptap/extensions",
    "@tiptap/pm",
    "@tiptap/react",
    "@tiptap/starter-kit",
    "@tiptap/suggestion",
    "@vercel/og",
    "@vezham/docs-core",
    "@vezham/docs-mdx",
    "@vezham/docs-openapi",
    "@vezham/docs-react",
    "@vezham/docs-story",
    "@vezham/icons-react",
    "@vezham/react-pro-v3",
    "@vezham/react-v3",
    // vx-bot/NOTE: Shared docs CSS imports its generated stylesheet export.
    "@vezham/start",
    "@vezham/styles-v3",
    "@vezham/use-logger",
    // vx-bot/NOTE: Retained at the workspace root for future consumers.
    "@vezham/utils",
    "axios",
    "embla-carousel",
    "embla-carousel-react",
    "eslint-plugin-playwright",
    "maplibre-gl",
    "marked",
    "nitro",
    "react",
    "react-dom",
    "react-markdown",
    "recharts",
    "remark-breaks",
    "remark-gfm",
    "shiki",
    "streamdown",
    // vx-bot/NOTE: React v3's tv exports reference these types in generated declarations.
    "tailwind-variants",
    "yaml",
    "yargs"
  ],
  "ignoreDependencyOverrides": [
    { "package": "follow-redirects", "source": "pnpm-workspace.yaml" },
    { "package": "body-parser", "source": "pnpm-workspace.yaml" },
    { "package": "fast-uri", "source": "pnpm-workspace.yaml" },
    // vx-bot/NOTE: These transitive peer aliases resolve to the forks in pnpm-lock.yaml.
    { "package": "fumadocs-core", "source": "pnpm-workspace.yaml" },
    { "package": "fumadocs-ui", "source": "pnpm-workspace.yaml" },
    // vx-bot/NOTE: Fallow 3.25 reads only the first document of pnpm 12's lockfile.
    // These security override targets are resolved in the second document.
    // vx-bot/TODO: Remove these exceptions when Fallow supports multi-document lockfiles;
    // keep each security override until pnpm audit confirms it is no longer needed.
    { "package": "sharp", "source": "pnpm-workspace.yaml" },
    { "package": "uuid", "source": "pnpm-workspace.yaml" },
    { "package": "qs", "source": "pnpm-workspace.yaml" },
    { "package": "undici", "source": "pnpm-workspace.yaml" },
    { "package": "js-yaml", "source": "pnpm-workspace.yaml" },
    { "package": "smol-toml", "source": "pnpm-workspace.yaml" },
    { "package": "seroval", "source": "pnpm-workspace.yaml" },
    { "package": "handlebars", "source": "pnpm-workspace.yaml" },
    { "package": "http-cache-semantics", "source": "pnpm-workspace.yaml" },
    { "package": "compression", "source": "pnpm-workspace.yaml" },
    {
      "package": "brace-expansion",
      "source": "pnpm-workspace.yaml"
    },
    { "package": "figlet", "source": "pnpm-workspace.yaml" },
    {
      "package": "serialize-javascript",
      "source": "pnpm-workspace.yaml"
    }
  ],
  "duplicates": {
    "ignore": [
      // vx-bot/NOTE: CLI app Vite configs stay local so generated apps are self-contained.
      "apps*/*/vite.config.ts",
      // vx-bot/NOTE: CLI template pages are copied into each app with its own routes.
      "apps*/**/src/pages/{home,pro}/index.tsx"
    ]
  },
  "health": {
    // vx-bot/TODO: Restore coverage enforcement when CLI template tests are established.
    // Remove maxCrap: 0 and restore the coverage path below.
    // "coverage": "test-output/audit/eslint-coverage/coverage-final.json",
    "maxCrap": 0
  },
  "rules": {
    "coverage-gaps": "off"
  }
}
