{
  "name": "crm",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/crm/src",
  "implicitDependencies": ["devtools", "react"],
  "targets": {
    "build": {
      "dependsOn": ["metadata:generate", "deploy:generate", "^build"],
      "outputs": ["{projectRoot}/.output"],
      "options": {
        "command": "vite build && node tools/offline.mjs",
        "cwd": "apps/crm"
      }
    },
    "dev": {
      "dependsOn": ["metadata:watch"]
    },
    "hosts:setup": {},
    "deploy:generate": {},
    "metadata:generate": {},
    "metadata:watch": {},
    "routes:tanstack": {},
    "serve-static": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "command": "node tools/preview.mjs",
        "cwd": "apps/crm"
      }
    },
    "e2e": {
      "dependsOn": ["build"]
    },
    "lint-style": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "stylelint src/app/global.css",
        "cwd": "apps/crm"
      }
    }
  },
  "tags": ["category:apps"]
}
