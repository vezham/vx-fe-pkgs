{
  "extends": ["../../../tsconfig.base.json", "../../../tsconfig.spec.json"],
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
