{
  "name": "@vezham/env",
  "version": "26.0.0-alpha.6",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/vx-fe-pkgs.git",
    "directory": "packages/core/env"
  },
  "sideEffects": true,
  "type": "module",
  "exports": {
    "./vite": {
      "@vx/fe-kit": "./src/lib/vite/index.ts",
      "types": "./dist/lib/vite/index.d.ts",
      "import": "./dist/lib/vite/index.js",
      "default": "./dist/lib/vite/index.js"
    },
    "./next/config": {
      "@vx/fe-kit": "./src/lib/next/env.ts",
      "types": "./dist/lib/next/env.d.ts",
      "import": "./dist/lib/next/env.js",
      "default": "./dist/lib/next/env.js"
    },
    "./next": {
      "@vx/fe-kit": "./src/lib/next/index.ts",
      "types": "./dist/lib/next/index.d.ts",
      "import": "./dist/lib/next/index.js",
      "default": "./dist/lib/next/index.js"
    },
    ".": {
      "@vx/fe-kit": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "!**/*.tsbuildinfo",
    "dist",
    "LICENSE"
  ]
}
