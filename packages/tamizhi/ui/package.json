{
  "name": "@vezham/tamizhi-ui",
  "version": "27.0.0-alpha.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/vx-fe-pkgs.git",
    "directory": "packages/tamizhi/ui"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "style": "./dist/index.css",
      "@vx/fe-kit": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./index.css": {
      "@vx/fe-kit": "./src/index.css",
      "default": "./dist/index.css"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "files": [
    "!**/*.tsbuildinfo",
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "@vezham/hooks": "workspace:*",
    "@vezham/icons-react": "catalog:",
    "@vezham/react-pro-v3": "catalog:",
    "@vezham/react-v3": "catalog:",
    "@vezham/tamizhi-client": "workspace:*",
    "@vezham/tamizhi-contracts": "workspace:*",
    "react-markdown": "catalog:"
  },
  "devDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
