{
  "name": "@vezham/template",
  "version": "26.0.0-beta.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/vx-fe-pkgs.git",
    "directory": "packages/template"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./components": {
      "@vx/fe-kit": "./src/lib/components/index.ts",
      "types": "./dist/lib/components/index.d.ts",
      "import": "./dist/lib/components/index.js",
      "default": "./dist/lib/components/index.js"
    },
    "./pages": {
      "@vx/fe-kit": "./src/lib/pages/index.ts",
      "types": "./dist/lib/pages/index.d.ts",
      "import": "./dist/lib/pages/index.js",
      "default": "./dist/lib/pages/index.js"
    },
    "./store": {
      "@vx/fe-kit": "./src/lib/store/index.ts",
      "types": "./dist/lib/store/index.d.ts",
      "import": "./dist/lib/store/index.js",
      "default": "./dist/lib/store/index.js"
    },
    "./app": {
      "@vx/fe-kit": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    ".": {
      "style": "./dist/index.css",
      "@vx/fe-kit": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "files": [
    "!**/*.tsbuildinfo",
    "dist",
    "LICENSE"
  ]
}
