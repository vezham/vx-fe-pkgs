{
  "name": "@vezham/config",
  "version": "26.0.0-beta.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vezham/vx-fe-pkgs.git",
    "directory": "packages/config"
  },
  "sideEffects": [
    "./dist/lib/integrations/vitest/setup/*.js"
  ],
  "type": "module",
  "exports": {
    "./vite": {
      "types": "./src/lib/integrations/vite/index.ts",
      "default": "./workspace/vite.js"
    },
    "./next": {
      "types": "./src/lib/integrations/next/index.ts",
      "default": "./workspace/next.js"
    },
    "./vitest": {
      "types": "./src/lib/integrations/vitest/index.ts",
      "default": "./workspace/vitest.js"
    },
    "./vitest/react": {
      "types": "./src/lib/integrations/vitest/frameworks/react.ts",
      "default": "./workspace/vitest/react.js"
    },
    "./vitest/next": {
      "types": "./src/lib/integrations/vitest/frameworks/next.ts",
      "default": "./workspace/vitest/next.js"
    },
    "./vitest/docs": {
      "types": "./src/lib/integrations/vitest/frameworks/docs.ts",
      "default": "./workspace/vitest/docs.js"
    },
    "./playwright": {
      "types": "./src/lib/integrations/playwright/index.ts",
      "default": "./workspace/playwright.js"
    },
    "./playwright/test": {
      "types": "./src/lib/integrations/playwright/test.ts",
      "default": "./workspace/playwright/test.js"
    },
    "./presets/app": {
      "types": "./src/lib/presets/app/index.ts",
      "default": "./workspace/presets/app.js"
    },
    "./presets/cdn": {
      "types": "./src/lib/presets/cdn/index.ts",
      "default": "./workspace/presets/cdn.js"
    },
    "./presets/docs": {
      "types": "./src/lib/presets/docs/index.ts",
      "default": "./workspace/presets/docs.js"
    },
    "./metadata": {
      "types": "./src/lib/metadata/index.ts",
      "default": "./workspace/metadata.js"
    },
    "./deploy": {
      "types": "./src/lib/deploy/index.ts",
      "default": "./workspace/deploy.js"
    },
    "./vite-lib": {
      "types": "./src/lib/integrations/vite-lib/index.ts",
      "default": "./workspace/vite-lib.js"
    },
    "./vite-lib/react": {
      "types": "./src/lib/integrations/vite-lib/react.ts",
      "default": "./workspace/vite-lib/react.js"
    },
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./vitest/setup/react": "./src/lib/integrations/vitest/setup/react.ts",
    "./vitest/setup/next": "./src/lib/integrations/vitest/setup/next.ts"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "vezham-deploy": "./dist/lib/deploy/cli.js",
    "vezham-docs": "./dist/lib/presets/docs/cli.js",
    "vezham-metadata": "./dist/lib/metadata/cli.js"
  },
  "files": [
    "!**/*.tsbuildinfo",
    "dist",
    "LICENSE"
  ],
  "dependencies": {
    "yaml": "catalog:"
  },
  "publishConfig": {
    "exports": {
      "./vite": {
        "types": "./dist/lib/integrations/vite/index.d.ts",
