        "default": "./dist/lib/deploy/index.js"
      },
      "./vite-lib": {
        "types": "./dist/lib/integrations/vite-lib/index.d.ts",
        "import": "./dist/lib/integrations/vite-lib/index.js",
        "default": "./dist/lib/integrations/vite-lib/index.js"
      },
      "./vite-lib/react": {
        "types": "./dist/lib/integrations/vite-lib/react.d.ts",
        "import": "./dist/lib/integrations/vite-lib/react.js",
        "default": "./dist/lib/integrations/vite-lib/react.js"
