      },
      "./presets/app": {
        "types": "./dist/lib/presets/app/index.d.ts",
        "import": "./dist/lib/presets/app/index.js",
        "default": "./dist/lib/presets/app/index.js"
      },
      "./presets/cdn": {
        "types": "./dist/lib/presets/cdn/index.d.ts",
        "import": "./dist/lib/presets/cdn/index.js",
        "default": "./dist/lib/presets/cdn/index.js"
      },
      "./presets/docs": {
